{
  "name": "dsh-session-hub",
  "version": "1.0.0",
  "type": "module",
  "description": "DSH 会话中心：单工具 session——读清单/摘要/完整对话 + 新建/改名/发消息/中断/归档/置顶；协作专家头部指示与自动回执",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek",
    "session",
    "collaboration",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/agnx/dsh-session-hub"
  }
}